<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/themeBackgroundColor"
    android:paddingBottom="42dp">

    <!-- 상단 스와이프 슬릭 핸들바 -->
    <View
        android:id="@+id/dragHandle"
        android:layout_width="48dp"
        android:layout_height="5dp"
        android:layout_marginTop="12dp"
        android:background="#D1D5DB"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 즐겨찾기 버튼 (우측 상단에 고급스럽게 플로팅) -->
    <ImageButton
        android:id="@+id/btnToggleFavorite"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="즐겨찾기"
        android:scaleType="centerInside"
        android:src="@drawable/ic_heart_outline"
        app:tint="#EF4444"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 중앙 도서 표지 프리미엄 디자인 (비율 3:4 적용) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/coverCard"
        android:layout_width="160dp"
        android:layout_height="0dp"
        android:layout_marginTop="40dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="24dp"
        app:layout_constraintDimensionRatio="H,3:4"
        app:layout_constraintTop_toBottomOf="@id/dragHandle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <ImageView
            android:id="@+id/imgBottomSheetCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@android:color/transparent" />
    </androidx.cardview.widget.CardView>

    <!-- 책 제목 -->
    <TextView
        android:id="@+id/txtBookTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:layout_marginHorizontal="32dp"
        android:text="도서 제목"
        android:textColor="?attr/themeTextColor"
        android:textSize="24sp"
        android:textStyle="bold"
        android:letterSpacing="-0.02"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/coverCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 전집 구성 요약 정보 -->
    <TextView
        android:id="@+id/txtSeriesDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="32dp"
        android:text="전집 요약 정보가 여기에 표시됩니다."
        android:textColor="?attr/themeSubTextColor"
        android:textSize="15sp"
        android:lineSpacingExtra="6dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/txtBookTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 하단 액션 버튼 그룹 (여백과 비율 최적화) -->
    <LinearLayout
        android:id="@+id/actionGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="40dp"
        android:paddingHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@id/txtSeriesDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPreviewPdf"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="60dp"
                android:layout_marginEnd="6dp"
                android:text="📖 전자책 재생"
                android:textColor="?attr/themeBackgroundColor"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="?attr/themeTextColor"
                app:cornerRadius="16dp"
                app:elevation="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPreviewVideo"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="60dp"
                android:layout_marginStart="6dp"
                android:text="🎬 영상 감상"
                android:textColor="?attr/themeBackgroundColor"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="?attr/themeTextColor"
                app:cornerRadius="16dp"
                app:elevation="2dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPreviewVideo2"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:text="🎬 확장 영상 감상"
            android:textColor="?attr/themeBackgroundColor"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="?attr/themeTextColor"
            app:cornerRadius="16dp" />

        <!-- 듀얼 뷰 킬러 기능 강조 (프리미엄 그라데이션 대신 엣지 포인트) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPreviewTogether"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="20dp"
            android:text="📖 ✨ 🎬 앱 듀얼모드로 함께 보기"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:visibility="gone"
            app:backgroundTint="#6366F1"
            app:cornerRadius="20dp"
            app:strokeColor="#A5B4FC"
            app:strokeWidth="1dp"
            app:elevation="8dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
