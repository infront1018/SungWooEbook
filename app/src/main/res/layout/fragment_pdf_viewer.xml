<?xml version="1.0" encoding="utf-8"?>
<!-- PDF 뷰어 Fragment 레이아웃 -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_space_theme">

    <com.github.barteksc.pdfviewer.PDFView
        android:id="@+id/pdfView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="16dp" />

    <!-- 로딩 프로그레스바 (인디고 테마) -->
    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="#4F46E5"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/txtLoadingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="신비로운 지식을 불러오는 중..."
            android:textColor="#94A3B8"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- 페이지 인디케이터 (반투명 스타일) -->
    <TextView
        android:id="@+id/txtPageNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp"
        android:background="@drawable/bg_floating_nav"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- 플로팅 닫기 버튼 -->
    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:src="@drawable/ic_close_white"
        android:background="@drawable/circle_button_background"
        android:backgroundTint="#880B0F19"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:contentDescription="닫기" />

</FrameLayout>
