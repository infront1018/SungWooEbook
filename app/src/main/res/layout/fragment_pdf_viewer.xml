<?xml version="1.0" encoding="utf-8"?>
<!-- PDF 뷰어 Fragment 레이아웃 -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBackgroundColor">

    <com.sungwoobook.ebook.view.PageFlipView
        android:id="@+id/pageFlipView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 로딩 프로그레스바 (인디고 테마) -->
    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="#4F46E5"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/txtLoadingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="신비로운 지식을 불러오는 중..."
            android:textColor="?attr/themeSubTextColor"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- 페이지 인디케이터 (반투명 스타일) -->
    <TextView
        android:id="@+id/txtPageNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp"
        android:background="@drawable/bg_floating_nav"
        android:textColor="?attr/themeTextColor"
        android:textSize="13sp"
        android:visibility="gone" />

</FrameLayout>
