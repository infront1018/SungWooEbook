<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBackgroundColor"
    android:paddingTop="80dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="테마 설정"
            android:textColor="?attr/themeTextColor"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"/>

        <RadioGroup
            android:id="@+id/radioGroupTheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_popup_rounded"
            android:backgroundTint="?attr/themeCardColor"
            android:padding="8dp">

            <RadioButton
                android:id="@+id/radioDefault"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="기본 모드 (프리미엄 다크)"
                android:textColor="?attr/themeTextColor"
                android:buttonTint="?attr/themeAccentColor"
                android:paddingStart="12dp"
                android:checked="true"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/themeDividerColor"
                android:layout_marginHorizontal="16dp"/>

            <RadioButton
                android:id="@+id/radioDark"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="다크 모드"
                android:textColor="?attr/themeTextColor"
                android:paddingStart="12dp"
                android:buttonTint="?attr/themeAccentColor"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/themeDividerColor"
                android:layout_marginHorizontal="16dp"/>

            <RadioButton
                android:id="@+id/radioWhite"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="화이트 모드"
                android:textColor="?attr/themeTextColor"
                android:paddingStart="12dp"
                android:buttonTint="?attr/themeAccentColor"/>
        </RadioGroup>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
