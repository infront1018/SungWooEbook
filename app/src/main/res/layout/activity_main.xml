<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 전체 배경 이미지 -->
    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/ebook_background"
        android:contentDescription="@string/app_name" />

    <!-- 전역 상단 타이틀바 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/globalHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingTop="12dp"
        android:paddingHorizontal="24dp"
        android:background="?attr/themeHeaderColor"
        android:elevation="10dp">

        <TextView
            android:id="@+id/txtHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="성우주니어"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/themeTextColor"
            android:letterSpacing="0.05"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Fragment 컨테이너 (Single Activity Architecture) -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="64dp" />

    <!-- 플로팅 내비게이션 바 (콤팩트 프리미엄 디자인) -->
    <LinearLayout
        android:id="@+id/floatingNav"
        android:layout_width="wrap_content"
        android:layout_height="62dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="52dp"
        android:background="@drawable/bg_floating_nav"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:gravity="center"
        android:elevation="24dp">

        <!-- Home -->
        <LinearLayout
            android:id="@+id/layoutHome"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btnHome"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home"
                app:tint="?attr/themeAccentColor" />
            <View
                android:id="@+id/indicatorHome"
                android:layout_width="14dp"
                android:layout_height="2.5dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_nav_indicator"
                android:visibility="visible" />
        </LinearLayout>

        <!-- Favorites -->
        <LinearLayout
            android:id="@+id/layoutFavorites"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btnFavorites"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_favorites"
                app:tint="?attr/themeSubTextColor" />
            <View
                android:id="@+id/indicatorFavorites"
                android:layout_width="14dp"
                android:layout_height="2.5dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_nav_indicator"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Settings -->
        <LinearLayout
            android:id="@+id/layoutSettings"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btnSettings"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_settings"
                app:tint="?attr/themeSubTextColor" />
            <View
                android:id="@+id/indicatorSettings"
                android:layout_width="14dp"
                android:layout_height="2.5dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_nav_indicator"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
