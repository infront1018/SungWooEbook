<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 밑면 그림자/어두운 부분 -->
    <item android:top="4dp" android:left="4dp" android:right="4dp">
        <shape>
            <solid android:color="#080B12" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    
    <!-- 선반 윗면 (메탈릭/유리 재질) -->
    <item android:bottom="4dp">
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#2E3C56"
                android:endColor="#151E32" />
            <stroke android:width="1dp" android:color="#475569" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- 상단 가장자리 빛 반사 라인 -->
    <item android:bottom="4dp">
        <shape>
            <stroke android:width="1dp" android:color="#94A3B8" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
