<resources>

    <!-- ✅ 앱 전체 테마 정의 -->
    <style name="AppTheme.Default" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="themeBackgroundColor">#0B0F19</item>
        <item name="themeCardColor">#1A1F2E</item>
        <item name="themeHeaderColor">#E60B0F19</item>
        <item name="themeTextColor">#FFFFFF</item>
        <item name="themeSubTextColor">#6B7280</item>
        <item name="themeAccentColor">#4F46E5</item>
        <item name="themeDividerColor">#2D3548</item>
        
        <item name="android:windowBackground">#0B0F19</item>
        <item name="android:statusBarColor">#0B0F19</item>
        <item name="android:navigationBarColor">#0B0F19</item>
    </style>

    <style name="AppTheme.Dark" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="themeBackgroundColor">#000000</item>
        <item name="themeCardColor">#121212</item>
        <item name="themeHeaderColor">#D9000000</item>
        <item name="themeTextColor">#E0E0E0</item>
        <item name="themeSubTextColor">#757575</item>
        <item name="themeAccentColor">#3F51B5</item>
        <item name="themeDividerColor">#212121</item>

        <item name="android:windowBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>

    <style name="AppTheme.White" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="themeBackgroundColor">#F9FAFB</item>
        <item name="themeCardColor">#FFFFFF</item>
        <item name="themeHeaderColor">#E6FFFFFF</item>
        <item name="themeTextColor">#111827</item>
        <item name="themeSubTextColor">#6B7280</item>
        <item name="themeAccentColor">#4F46E5</item>
        <item name="themeDividerColor">#E5E7EB</item>

        <item name="android:windowBackground">#F9FAFB</item>
        <item name="android:statusBarColor">#F9FAFB</item>
        <item name="android:navigationBarColor">#F9FAFB</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="AppTheme" parent="AppTheme.Default" />

    <!-- ✅ BottomNavigationView용 사용자 정의 스타일 -->
    <style name="Widget.Custom.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@android:color/transparent</item>
        <item name="itemRippleColor">@android:color/transparent</item>
        <item name="itemBackground">@android:color/transparent</item>
    </style>

</resources>
